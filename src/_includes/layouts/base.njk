<style>
  .material-symbols-outlined {
    font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
  }
  .editorial-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 2rem;
  }
  .tonal-transition {
    transition: background-color 0.3s ease;
  }

  /* --- Rotating words hero --- */
  .words-wrapper {
    display: inline-block;
    overflow: hidden;
    height: 1.1em;
    vertical-align: top;
  }
  .words-rotate {
    display: block;
  }
  .words-rotate span {
    display: block;
    line-height: 1.1;
  }
  /* 6 mots + 1 doublon = 7 spans, 18s total, 3s/mot */
  @keyframes wordsUp {
    0%      { transform: translateY(0);        animation-timing-function: linear; }
    13%     { transform: translateY(0);        animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1); }
    16.67%  { transform: translateY(-1.1em);   animation-timing-function: linear; }
    29.67%  { transform: translateY(-1.1em);   animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1); }
    33.33%  { transform: translateY(-2.2em);   animation-timing-function: linear; }
    46.33%  { transform: translateY(-2.2em);   animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1); }
    50%     { transform: translateY(-3.3em);   animation-timing-function: linear; }
    63%     { transform: translateY(-3.3em);   animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1); }
    66.67%  { transform: translateY(-4.4em);   animation-timing-function: linear; }
    79.67%  { transform: translateY(-4.4em);   animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1); }
    83.33%  { transform: translateY(-5.5em);   animation-timing-function: linear; }
    96.33%  { transform: translateY(-5.5em);   animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1); }
    100%    { transform: translateY(-6.6em); }
  }
  .words-rotate {
    animation: wordsUp 18s infinite;
  }

  /* --- Maintenance banner marquee --- */
  @keyframes marquee {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee 28s linear infinite;
  }
  .marquee-track:hover {
    animation-play-state: paused;
  }
</style>
</head>
<body class="bg-surface text-on-surface font-body selection:bg-secondary-container">

<!-- Bandeau maintenance -->
<div class="fixed top-0 w-full z-[60] bg-secondary-container overflow-hidden" style="height:36px;">
  <div class="marquee-track h-full items-center flex">
    {% set segment %}
      <span class="flex items-center gap-3 px-8 text-on-secondary-fixed font-label text-xs font-semibold uppercase tracking-widest whitespace-nowrap">
        <span class="material-symbols-outlined text-sm" style="font-variation-settings:'FILL' 1;">construction</span>
        Site en maintenance — récupération des archives en cours — nous nous excusons du désagrément
        <span class="text-secondary mx-4">◆</span>
      </span>
    {% endset %}
    {{ segment | safe }}{{ segment | safe }}{{ segment | safe }}{{ segment | safe }}{{ segment | safe }}{{ segment | safe }}
  </div>
</div>

{% include "partials/nav.njk" %}

<main>
{{ content | safe }}
</main>

{% include "partials/footer.njk" %}

</body>
</html>
