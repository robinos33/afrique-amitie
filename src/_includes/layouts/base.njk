<!DOCTYPE html>
<html class="light" lang="fr">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>{{ title }}</title>
<meta name="description" content="{{ description }}"/>
<link rel="icon" href="/assets/favicon-32x32.png" sizes="32x32" type="image/png"/>
<link rel="icon" href="/assets/favicon-192x192.png" sizes="192x192" type="image/png"/>
<link rel="apple-touch-icon" href="/assets/favicon-apple-180x180.png"/>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Epilogue:wght@700;800&amp;family=Plus+Jakarta+Sans:wght@400;500;600&amp;family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" onload="this.onload=null;this.rel='stylesheet'"/>
<noscript><link href="https://fonts.googleapis.com/css2?family=Epilogue:wght@700;800&amp;family=Plus+Jakarta+Sans:wght@400;500;600&amp;family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/></noscript>
<link rel="stylesheet" href="/assets/css/main.css"/>
<style>
  .material-symbols-outlined {
    font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
  }
  .editorial-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 2rem;
  }
  .tonal-transition {
    transition: background-color 0.3s ease;
  }

  /* --- Rotating words hero --- */
  .words-wrapper {
    display: inline-block;
    overflow: hidden;
    height: 1.1em;
    vertical-align: top;
  }
  .words-rotate {
    display: block;
  }
  .words-rotate span {
    display: block;
    line-height: 1.1;
  }
  /* 6 mots + 1 doublon = 7 spans, 18s total, 3s/mot */
  @keyframes wordsUp {
    0%      { transform: translateY(0);        animation-timing-function: linear; }
    13%     { transform: translateY(0);        animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1); }
    16.67%  { transform: translateY(-1.1em);   animation-timing-function: linear; }
    29.67%  { transform: translateY(-1.1em);   animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1); }
    33.33%  { transform: translateY(-2.2em);   animation-timing-function: linear; }
    46.33%  { transform: translateY(-2.2em);   animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1); }
    50%     { transform: translateY(-3.3em);   animation-timing-function: linear; }
    63%     { transform: translateY(-3.3em);   animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1); }
    66.67%  { transform: translateY(-4.4em);   animation-timing-function: linear; }
    79.67%  { transform: translateY(-4.4em);   animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1); }
    83.33%  { transform: translateY(-5.5em);   animation-timing-function: linear; }
    96.33%  { transform: translateY(-5.5em);   animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1); }
    100%    { transform: translateY(-6.6em); }
  }
  .words-rotate {
    animation: wordsUp 18s infinite;
  }

</style>
</head>
<body class="bg-surface text-on-surface font-body selection:bg-secondary-container">

{% include "partials/nav.njk" %}

<main>
{{ content | safe }}
</main>

{% include "partials/footer.njk" %}

</body>
</html>
