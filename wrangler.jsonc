{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "afrique-amitie",
  "main": "worker.js",
  "compatibility_date": "2026-05-10",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "_site",
    "not_found_handling": "404-page",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    { "pattern": "afrique-amitie.fr", "custom_domain": true }
  ]
}
